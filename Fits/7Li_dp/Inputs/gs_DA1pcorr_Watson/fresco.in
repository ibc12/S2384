7Li(d,p)8Li(bound) 7.45AMeV FR DWBA DA1p Watson
NAMELIST
 &FRESCO hcm=0.1 rmatch=60 rintp=0.1 hnl=0.1 rnl=6.0 centre=0.0
         jtmin=0.0 jtmax=30
         absend=-0.0100 jump(1:6:1)= 0  0  0  0  0  0 jbord(1:6)=0  0  0  0  0.0  0.0
	 kqmax=0
	 thmin=0.0 thmax=-180.0 thinc=1.0 cutl=-2.0 cutr=0 cutc=0 ips=0.0000 
         it0=1 iter=1 iblock=0 pade=0 nnu=36 chans=1 smats=2 nlpl=1
         xstabl=1 elab(1:4)=14.57  0  0  0 nlab(1:3)= 0  0  0 
         unitmass=1.000000 finec=137.03599  /

 &PARTITION namep='deuteron' massp=2.01355 zp=1 namet='7Li' masst=7.01436 zt=3 qval=0.000 pwf=F nex=1 /
 &STATES jp=1.0 bandp=+1 ep=0.0   cpot=1  jt=1.5 bandt=-1 et=0.0 /

 &PARTITION namep='proton' massp=1.00728 zp=1 namet='8Li' masst=8.02084 zt=3 qval=-0.1919 pwf=F nex=5 /
 &STATES jp=0.5 bandp=+1 ep=0.0   cpot=4  jt=2.0 bandt=+1 et=0.0 /
 &STATES jp=0.5 bandp=1 ep=0.0000 cpot=5 jt=1.0 bandt=+1 et=0.98/
 &STATES jp=0.5 bandp=1 ep=0.0000 cpot=6 jt=3.0 bandt=+1 et=1.833/
 &STATES jp=0.5 bandp=1 ep=0.0000 cpot=6 jt=3.0 bandt=+1 et=1.933/
 &STATES jp=0.5 bandp=1 ep=0.0000 cpot=6 jt=3.0 bandt=+1 et=2.255/

&partition /
 
 ! DA1p for: Target (A, Z) = (7.0000, 3.0000) + Projectile (A, Z) = (2.0000, 1.0000) @ 14.5311 MeV
&pot kp=1 type=0 p(1:3)= 7.0000  0.0000  1.3000 /
&pot kp=1 type=1 p(1:6)= 40.9114  2.0811  0.8440  0.0000  2.2631  0.2610 /
&pot kp=1 type=2 p(1:6)= 0.0000  0.0000  0.0000  14.6107  2.2631  0.2610 /
&pot kp=1 type=3 p(1:6)= 0.0000  0.0000  0.0000  0.0000  0.0000  0.0000 /

 ! Reid soft core potential T = 0 for deuteron overlap
 &POT kp=2 type=0  ap=0 at=1 rc=1.25 /
 &POT kp=2 type=1 shape=5 p1=1.0 p3=1.0 /
 &POT kp=2 type=3 shape=5 p1=1.0 p3=1.0 /
 &POT kp=2 type=4 shape=5 p1=1.0 p3=1.0 /
 &POT kp=2 type=7 shape=5 p1=1.0 p3=1.0 /
 
 ! 8Li + n binding potential (standard WS presciption but with rso = 1.25 also as in 2fnr)
&pot kp=3 type=0 p(1:3)= 7.00    0.0000  1.2500 /
&pot kp=3 type=1 p(1:3)= 50.000  1.2500  0.6500 /
&pot kp=3 type=3 p(1:3)= 6.000  1.2500  0.6500 /

! 8Li + n binding potential (standard WS presciption but with rso = 1.25 also as in 2fnr)
! Different potential depth because of correction to binned data with DWUCK4 or 5
&pot kp=31 type=0 p(1:3)= 7.00    0.0000  1.2500 /
&pot kp=31 type=1 p(1:3)= 34.435  1.2500  0.6500 /
&pot kp=31 type=3 p(1:3)= 6.000  1.2500  0.6500 /

! Watson for: Target (A, Z) = (8.0000, 3.0000) + Projectile (A, Z) = (1.0000, 1.0000) @ 12.4917 MeV
&pot kp=4 type=0 p(1:3)= 8.0000  0.0000  1.1389 /
&pot kp=4 type=1 p(1:6)= 64.0189  1.1389  0.5700  0.0000  1.1389  0.5000 /
&pot kp=4 type=2 p(1:6)= 0.0000  0.0000  0.0000  9.6064  1.1389  0.5000 /
&pot kp=4 type=3 p(1:6)= 5.5000  1.1389  0.5700  0.0000  0.0000  0.0000 /

! Watson for: Target (A, Z) = (8.0000, 3.0000) + Projectile (A, Z) = (1.0000, 1.0000) @ 11.3859 MeV
&pot kp=5 type=0 p(1:3)= 8.0000  0.0000  1.1399 /
&pot kp=5 type=1 p(1:6)= 64.3138  1.1399  0.5700  0.0000  1.1399  0.5000 /
&pot kp=5 type=2 p(1:6)= 0.0000  0.0000  0.0000  8.9773  1.1399  0.5000 /
&pot kp=5 type=3 p(1:6)= 5.5000  1.1399  0.5700  0.0000  0.0000  0.0000 /

! Watson for: Target (A, Z) = (8.0000, 3.0000) + Projectile (A, Z) = (1.0000, 1.0000) @ 9.9501 MeV
&pot kp=6 type=0 p(1:3)= 8.0000  0.0000  1.1412 /
&pot kp=6 type=1 p(1:6)= 64.6966  1.1412  0.5700  0.0000  1.1412  0.5000 /
&pot kp=6 type=2 p(1:6)= 0.0000  0.0000  0.0000  8.1605  1.1412  0.5000 /
&pot kp=6 type=3 p(1:6)= 5.5000  1.1412  0.5700  0.0000  0.0000  0.0000 /



&pot /

! Form factor of deuteron
 &OVERLAP kn1=1 kn2=2 ic1=2 ic2=1 in=-1 kind=3 nn=1 l=0 lmax=2 sn=0.5 j=0.5 kbpot=2 krpot=0 be=2.225 isc=7 ipc=4 nfl=0 /
 ! Form factor of 8Li + n
 &OVERLAP kn1=3 kn2=3 ic1=1 ic2=2 in=2 kind=0 nn=1 l=1 lmax=0 sn=0.5 j=1.5 kbpot=31 krpot=0 be=2.033 isc=1 ipc=4 nfl=-22 /
! Form factor of 8Li + n 1st excited
&OVERLAP kn1=4 kn2=4 ic1=1 ic2=2 in=2 kind=0 nn=1 l=1 sn=0.5 j=1.5 kbpot=31 be=1.0527 isc=1 ipc=4 nfl=0 nam=0 ampl=0.0 /
! Form factor of 8Li + n 2nd excited
&OVERLAP kn1=5 kn2=5 ic1=1 ic2=2 in=2 kind=0 nn=1 l=1 sn=0.5 j=1.5 kbpot=31 be=0.200 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0/
&OVERLAP kn1=6 kn2=6 ic1=1 ic2=2 in=2 kind=0 nn=1 l=1 sn=0.5 j=1.5 kbpot=31 be=0.100 isc=1 ipc=3 nfl=0 nam=0 ampl=0.0/
&OVERLAP kn1=7 kn2=7 ic1=1 ic2=2 in=2 kind=0 nn=1 l=1 sn=0.5 j=1.5 kbpot=31 be=-0.1223 isc=4 ipc=3 nfl=0 nk=100 er=-0.5/
&overlap /

! 0 range: kind = 5 and set p1 = D0 p2= LEA (0 by default 2FNR)
! D0 constant = -125.19 MeV fm^3/2 from FRONT Reid-Core
! Finite range: kind = 7 -> p1,p2 not used

&COUPLING
icto=-2 icfrom=1 kind=5 ip1=0 ip2=0 ip3=0 p1=125.19 p2=0 /
! Projectile coupling (ignored if kind=5=zero-range)
&cfp  in=1 ib=1 ia=1 kn=1  a=1.0 /
! Heavy couplings
&cfp  in=2 ib=1 ia=1 kn=3  a=1.0 /
&cfp  in=2 ib=2 ia=1 kn=4  a=1.0 /
&cfp  in=2 ib=3 ia=1 kn=5  a=1.0 /
&cfp  in=2 ib=4 ia=1 kn=6  a=1.0 /
&cfp  in=-2 ib=5 ia=1 kn=7  a=1.0 /
&coupling /
