# --- NEW: change fort.7 (title + values with no angle and 5 in same row) to "angle xs" ---
A0=0.0      # angle first value
STEP=1.0    # angular step
tail -n +2 fort.7 | tr -s ' ' '\n' | \
  awk -v a0=$A0 -v s=$STEP 'NF{printf "%8.2f %14.6E\n", a0+(NR-1)*s, $1}' > fort7_2col.dat

  
